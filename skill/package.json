{
  "name": "@ai-spec/skill",
  "version": "0.1.0-phase1",
  "description": "AI Spec Skill —— spec-first 工作流方法论的共享内核 + 可插拔适配器 + CLI 脚手架",
  "private": true,
  "type": "module",
  "bin": {
    "create-ai-spec-app": "./cli/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dod": "vitest run --dir test",
    "engine:parity": "vitest run test/parity-13-enforcements.test.ts",
    "typecheck": "tsc --noEmit",
    "cli:dev": "tsx cli/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "enquirer": "^2.4.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
